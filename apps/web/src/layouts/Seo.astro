---
interface Props {
  // Leave empty on the home page to show only the site name.
  title?: string;
  description?: string;
  // A 1200×630 share image in public/, such as /og/projects.png.
  image?: string;
  imageAlt?: string;
  // Keep this page out of search results.
  noindex?: boolean;
  type?: 'website' | 'article';
}

const siteName = 'Nick Bevers';

const {
  title,
  description = 'Nick Bevers, frontend engineer and artisanal crafts enjoyer.',
  image = '/og/nick-bevers.png',
  imageAlt = 'Nick Bevers, frontend engineer',
  noindex = false,
  type = 'website',
} = Astro.props;

const fullTitle = title ? `${title} · ${siteName}` : siteName;
// Built from `site` in astro.config, so the .vercel.app domain never becomes the canonical one.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageURL = new URL(image, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title ?? siteName} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Match --bg in tokens.css for each theme. -->
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f5f2" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#10221b" />

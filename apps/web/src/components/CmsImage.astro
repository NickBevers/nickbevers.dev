---
import type { Media } from '@site/cms/types';
import { mediaFallback, mediaSrcSet } from '@/lib/media';

interface Props {
  media: Media;
  /** Match the rendered width in your layout so the browser selects the smallest useful image. */
  sizes: string;
  alt?: string;
  /** Enable only for an above-the-fold / LCP image. */
  priority?: boolean;
  class?: string;
}

const { media, sizes, alt = media.alt, priority = false, class: className } = Astro.props;
const avif = mediaSrcSet(media, 'avif');
const webp = mediaSrcSet(media, 'webp');
const fallback = mediaFallback(media);
const hasSize = Boolean(media.width && media.height);

// An unprocessed image keeps its space and its name, but never fails the build. The deploy hook
// rebuilds once the worker has made the variants.
if (!fallback) {
  console.warn(
    `[CmsImage] Media ${media.id} is ${media.processingStatus || 'unprocessed'}. ` +
      (hasSize ? 'Rendering an empty placeholder.' : 'It has no size yet, so nothing is rendered.'),
  );
}

// The worker only stores a preview for fully opaque images.
const placeholder = media.blurDataURL?.startsWith('data:image/webp;base64,')
  ? media.blurDataURL
  : undefined;
---

{fallback ? (
  <cms-image
    class={className}
    data-fade={!priority && placeholder ? '' : undefined}
    style={{ '--preview': placeholder ? `url("${placeholder}")` : 'none' }}
  >
    <picture>
      {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
      <img
        src={fallback}
        srcset={webp}
        sizes={sizes}
        alt={alt}
        width={media.width}
        height={media.height}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
      />
    </picture>
  </cms-image>
) : (
  hasSize && (
    <cms-image
      class={className}
      data-pending
      role={alt ? 'img' : undefined}
      aria-label={alt || undefined}
      style={{ aspectRatio: `${media.width} / ${media.height}` }}
    />
  )
)}

<style>
  cms-image {
    display: block;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  cms-image::before {
    content: '';
    position: absolute;
    inset: -12px;
    z-index: -1;
    background: var(--preview) center / 100% 100%;
    filter: blur(8px);
  }

  cms-image[data-loaded]::before,
  cms-image[data-pending]::before {
    display: none;
  }

  cms-image[data-pending] {
    background: var(--bg-alt);
  }

  picture,
  img {
    display: block;
    width: 100%;
  }

  img {
    height: auto;
    transition: opacity var(--duration-base) var(--ease);
  }

  /* Only the script sets this, so without JavaScript images show as soon as they load. Reduced
     motion is handled in a11y.css, which shortens every transition. */
  cms-image[data-fading] img {
    opacity: 0;
    transition: none;
  }
</style>

<script>
  class CmsImage extends HTMLElement {
    connectedCallback() {
      const image = this.querySelector('img');
      if (!image) return;

      const loaded = () => {
        this.removeAttribute('data-fading');
        this.setAttribute('data-loaded', '');
      };
      if (image.complete) return loaded();

      // Priority images never fade: a hidden image can't count as the page's largest paint.
      if (this.hasAttribute('data-fade')) this.setAttribute('data-fading', '');
      image.addEventListener('load', loaded, { once: true });
      image.addEventListener('error', loaded, { once: true });
    }
  }

  if (!customElements.get('cms-image')) customElements.define('cms-image', CmsImage);
</script>

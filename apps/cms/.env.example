PAYLOAD_SECRET=replace-with-a-random-secret
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/nickbevers
# On Vercel, use Neon's pooled DATABASE_URL (or POSTGRES_URL). Use a separate Neon branch for previews.
CMS_PUBLIC_URL=http://localhost:3000
WEB_URL=http://localhost:4321

# Leave S3_BUCKET empty for local uploads. Set all values for Hetzner / Vercel.
S3_BUCKET=
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Worker only: optional Vercel frontend Deploy Hook, called after images are processed.
WEB_DEPLOY_HOOK=

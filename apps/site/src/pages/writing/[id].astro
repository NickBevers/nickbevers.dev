---
import { render } from "astro:content";
import EntryLayout from "../../layouts/EntryLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import PullQuote from "../../components/PullQuote.astro";
import { getEntries, neighbours, readingTime } from "../../lib/collections";

export async function getStaticPaths() {
  const list = await getEntries();
  return list.map((item) => ({
    params: { id: item.entry.id },
    props: { item, list },
  }));
}

const { item, list } = Astro.props;
const { Content } = await render(item.entry);
const { older, newer } = neighbours(list, item.entry.id);
const minutes = readingTime(item.entry.body ?? "");
---

<EntryLayout item={item} minutes={minutes} older={older} newer={newer}>
  <Content components={{ pre: CodeBlock, blockquote: PullQuote }} />
</EntryLayout>

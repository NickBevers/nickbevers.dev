---
// The brand's one graphic device: the logo's parallel stripes
---

<div class="stripes" aria-hidden="true">
  <div class="tint"></div>
  <div class="ink"></div>
  <div class="green"></div>
</div>

<style>
  /* A zero-width anchor marking the content edge, not the viewport edge */
  .stripes {
    position: absolute;
    inset-block: 0;
    inset-inline-end: max(0px, calc((100% - var(--measure)) / 2 + min(var(--gutter), 6vw)));
    inline-size: 0;
    overflow: visible;
  }

  .stripes > * {
    position: absolute;
    inset-block: 0;
    transform: skewX(38deg);
    transform-origin: 100% 0;
  }

  .tint  { background: var(--bg-alt); inset-inline-end: -40px; inline-size: 320px; }
  .ink   { background: var(--text);   inset-inline-end: 120px; inline-size: 16px; }
  .green { background: var(--logo);   inset-inline-end: 152px; inline-size: 32px; }

  @media (max-width: 900px) {
    .stripes { display: none; }
  }
</style>

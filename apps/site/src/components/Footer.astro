---
import { SITE, SOCIAL } from "../lib/nav";
const year = new Date().getFullYear();
---

<footer id="contact" class="ft">
  <div class="measure">
    <div class="top">
      <div>
        <p class="eyebrow">Sign the guestbook</p>
        <h2 class="h">Say hello,<br />the old-fashioned way.</h2>
        <a class="cta" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
      <ul class="links" role="list">
        {
          SOCIAL.map((s) => (
            <li>
              <a href={s.href} rel={"rel" in s ? s.rel : undefined}>
                {s.label}
                <span class="handle" aria-hidden="true">
                  {s.handle} →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="legal">
      <span>© {year} Nick Bevers · {SITE.city}</span>
      <span>Set in Hanken Grotesk</span>
    </div>
  </div>
</footer>

<style>
  /* Fixed dark green in both themes */
  .ft {
    border-top: var(--border-strong);
    background: var(--nb-green-900);
    color: var(--nb-green-100);
    padding-block: 70px var(--space-7);
  }
  .top {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 56px;
    align-items: end;
  }
  .eyebrow {
    margin: 0 0 18px;
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--nb-green-500);
  }
  .h {
    margin: 0;
    font-size: clamp(30px, 4.4vw, 44px);
    line-height: 1.03;
    font-weight: var(--weight-black);
    letter-spacing: -0.03em;
    color: var(--nb-green-050);
  }
  .cta {
    display: inline-block;
    margin-block-start: 28px;
    padding: 15px 26px;
    font-size: 16px;
    font-weight: var(--weight-black);
    color: var(--nb-green-900);
    background: var(--nb-sand-500);
    border: 1px solid var(--nb-green-050);
    box-shadow: 5px 5px 0
      color-mix(in srgb, var(--nb-green-050) 35%, transparent);
    text-decoration: none;
    transition:
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }
  .cta:hover {
    transform: translate(var(--press-shift), var(--press-shift));
    box-shadow: 2px 2px 0
      color-mix(in srgb, var(--nb-green-050) 35%, transparent);
  }
  .cta:focus-visible {
    outline: var(--focus-width) solid var(--nb-green-050);
    outline-offset: var(--focus-offset);
  }

  .links {
    display: flex;
    flex-direction: column;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-body-sm);
  }
  /* The dotted rules carry the rhythm, so every row is bounded the same way:
     a top rule on the first, a bottom rule on all. No extra gap between them. */
  .links li:first-child a {
    border-block-start: 1px dotted
      color-mix(in srgb, var(--nb-green-500) 50%, transparent);
  }
  .links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    min-block-size: var(--tap-min);
    padding: var(--space-4);
    margin-inline: calc(var(--space-4) * -1);
    border-bottom: 1px dotted
      color-mix(in srgb, var(--nb-green-500) 50%, transparent);
    color: var(--nb-green-100);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition:
      padding-inline-start var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .links a:hover {
    background: var(--footer-hover-bg);
    color: var(--footer-hover-on);
    padding-inline-start: 10px;
  }
  .links a:hover .handle {
    color: var(--footer-hover-2);
  }
  @media (prefers-reduced-motion: reduce) {
    .links a {
      transition: none;
    }
    .links a:hover {
      padding-inline-start: var(--space-4);
    }
  }
  .links a:focus-visible {
    outline: var(--focus-width) solid var(--nb-green-050);
    outline-offset: var(--focus-offset);
  }
  .handle {
    color: var(--nb-green-500);
  }

  .legal {
    display: flex;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    margin-block-start: 52px;
    padding-block-start: var(--space-5);
    border-top: 1px solid
      color-mix(in srgb, var(--nb-green-500) 28%, transparent);
    font-size: var(--text-meta);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--nb-green-500);
  }

  @media (max-width: 900px) {
    .ft {
      padding-block-end: 84px;
    }
  }

  @media (max-width: 760px) {
    .ft {
      padding-block: var(--space-9) 84px;
    }
    .top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      align-items: start;
    }

    /* No rule and no 52px gap here */
    .legal {
      margin-block-start: var(--space-6);
      padding-block-start: 0;
      border-top: 0;
      gap: var(--space-2);
      flex-direction: column;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta {
      transition: none;
    }
    .cta:hover {
      transform: none;
    }
  }
</style>

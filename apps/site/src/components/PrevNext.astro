---
import type { NumberedEntry } from "../lib/collections";
interface Props { older?: NumberedEntry; newer?: NumberedEntry; }
const { older, newer } = Astro.props;
---
{(older || newer) && (
  <nav class="pn" aria-label="More entries">
    {older ? (
      <a href={older.href} class="cell prev">
        <span class="dir"><span aria-hidden="true">←</span> Older</span>
        <span class="ttl">{older.entry.data.title}</span>
      </a>
    ) : <span />}
    {newer ? (
      <a href={newer.href} class="cell next">
        <span class="dir">Newer <span aria-hidden="true">→</span></span>
        <span class="ttl">{newer.entry.data.title}</span>
      </a>
    ) : <span />}
  </nav>
)}

<style>
  .pn {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    margin-block-start: var(--space-10);
    padding-block-start: var(--space-6);
    border-top: var(--rule-heavy);
  }
  .cell {
    display: flex; flex-direction: column; gap: var(--space-2);
    padding: var(--space-4);
    color: var(--text); text-decoration: none;
    border: var(--border-hair);
    transition: background var(--dur) var(--ease);
  }
  .cell:hover { background: var(--accent-bg); }
  .cell:focus-visible { outline: var(--focus-width) solid var(--focus-ring); outline-offset: var(--focus-offset); }
  .next { text-align: end; }
  .dir {
    font-size: var(--text-meta); font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-meta); text-transform: uppercase;
    color: var(--text-3);
  }
  .ttl { font-size: var(--text-body-sm); font-weight: var(--weight-bold); line-height: 1.3; }
  @media (max-width: 640px) {
    .pn { grid-template-columns: minmax(0, 1fr); }
    .next { text-align: start; }
  }
  @media (prefers-reduced-motion: reduce) { .cell { transition: none; } }
</style>

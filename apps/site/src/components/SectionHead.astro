---
interface Props {
  title: string;
  right?: string;
  /** When set, the right-hand label is a link rather than a plain label. */
  rightHref?: string;
  id?: string;
  /** "Off the clock" sits further from its grid than the list sections do. */
  gap?: "tight" | "loose";
}
const { title, right, rightHref, id, gap = "tight" } = Astro.props;
---
<div class:list={["sh", gap]}>
  <h2 id={id}>{title}</h2>
  {right && (rightHref
    ? <a class="right link" href={rightHref}>{right}</a>
    : <span class="right">{right}</span>)}
</div>

<style>
  .sh {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-6);
    padding-block-end: var(--space-3);
    border-bottom: var(--rule-heavy);
  }
  .tight { margin-block-end: var(--space-1); }
  .loose { margin-block-end: var(--space-6); }
  h2 {
    margin: 0; font-size: var(--text-h2);
    font-weight: var(--weight-black); letter-spacing: var(--tracking-title);
  }
  .right {
    flex: none;
    font-size: var(--text-meta); font-weight: var(--weight-bold);
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-3);
  }
  .link {
    display: inline-flex; align-items: center;
    min-block-size: var(--tap-min);
    color: var(--accent); text-decoration: none;
  }
  .link:hover { text-decoration: underline; text-decoration-style: dotted; }
  .link:focus-visible {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  @media (max-width: 520px) { .right { display: none; } }
</style>

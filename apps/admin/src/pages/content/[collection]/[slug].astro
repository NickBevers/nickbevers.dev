---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Button from "@nb/ui/core/Button.astro";
import { getCollection } from "@/lib/collections";
import { loadItem } from "@/lib/content";

export const prerender = false;
const session = Astro.locals.session!;

const col = getCollection(Astro.params.collection!);
if (!col) return Astro.redirect("/");

const slug = Astro.params.slug!;
const isNew = slug === "new";

const item = isNew ? null : await loadItem(session.token, col, slug);
if (!isNew && !item) return Astro.redirect(`/content/${col.key}/`);

const data = item?.data ?? {};
const title = isNew
  ? `New ${col.one.toLowerCase()}`
  : String(data[col.titleField] ?? slug);
---

<AdminLayout title={title} session={session}>
  <div class="wrap page">
    <header class="head">
      <div>
        <p class="eyebrow"><a href={`/content/${col.key}/`}>← {col.many}</a></p>
        <h1>{title}</h1>
      </div>
    </header>

    <form
      class="form"
      data-content-form
      data-collection={col.key}
      data-slug={isNew ? "" : slug}
      data-path={item?.path ?? ""}
      data-sha={item?.sha ?? ""}
    >
      {
        col.fields.map((f) => (
          <div class:list={["field", { inline: f.type === "boolean" }]}>
            <label for={f.name}>
              {f.label}
              {f.required && (
                <span class="req" aria-hidden="true">
                  *
                </span>
              )}
            </label>

            {f.type === "textarea" ? (
              <textarea
                id={f.name}
                name={f.name}
                rows="3"
                maxlength={f.max}
                required={f.required}
              >
                {String(data[f.name] ?? "")}
              </textarea>
            ) : f.type === "boolean" ? (
              <input
                id={f.name}
                name={f.name}
                type="checkbox"
                checked={data[f.name] === true}
              />
            ) : (
              <input
                id={f.name}
                name={f.name}
                type={
                  f.type === "number"
                    ? "number"
                    : f.type === "url"
                      ? "url"
                      : f.type === "date"
                        ? "date"
                        : "text"
                }
                value={String(data[f.name] ?? "")}
                maxlength={f.max}
                required={f.required}
              />
            )}

            {f.help && <p class="help">{f.help}</p>}
          </div>
        ))
      }

      {
        col.hasBody && (
          <div class="field">
            <label for="body">Body</label>
            <textarea id="body" name="body" rows="18">
              {item?.body ?? ""}
            </textarea>
            <p class="help">Markdown. Becomes the detail page.</p>
          </div>
        )
      }

      <div class="actions">
        <Button variant="primary" type="submit">Save</Button>
        <span class="status" data-status role="status" aria-live="polite"
        ></span>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-content-form]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;
    status.textContent = "Saving…";

    const fd = new FormData(form);
    const data: Record<string, unknown> = {};
    for (const [k, v] of fd.entries()) {
      if (k === "body") continue;
      data[k] = v;
    }
    // Unchecked boxes are absent from FormData, so they need an explicit false.
    for (const cb of form.querySelectorAll<HTMLInputElement>(
      'input[type="checkbox"]',
    )) {
      data[cb.name] = cb.checked;
    }

    const res = await fetch("/api/content/save", {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({
        collection: form.dataset.collection,
        slug: form.dataset.slug,
        path: form.dataset.path,
        sha: form.dataset.sha,
        data,
        body: String(fd.get("body") ?? ""),
      }),
    });

    const json = await res.json();
    if (!res.ok) {
      status.textContent = json.error ?? "Save failed";
      return;
    }

    status.textContent = "Saved";
    if (json.slug && !form.dataset.slug) {
      location.href = `/content/${form.dataset.collection}/${json.slug}/`;
    } else {
      form.dataset.sha = json.sha ?? "";
    }
  });
</script>

<style>
  .head {
    padding-block-end: var(--space-5);
    border-bottom: var(--rule-heavy);
  }
  .eyebrow {
    margin: 0 0 8px;
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }
  .eyebrow a {
    color: var(--warm-text);
    text-decoration: none;
  }
  .eyebrow a:hover {
    text-decoration: underline;
  }
  h1 {
    margin: 0;
    font-size: 34px;
    font-weight: var(--weight-black);
    letter-spacing: -0.02em;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-6);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field.inline {
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
  }
  .field.inline label {
    order: 2;
  }

  label {
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--text-2);
  }
  .req {
    color: var(--warm-text);
    margin-inline-start: 3px;
  }

  input[type="text"],
  input[type="url"],
  input[type="date"],
  input[type="number"],
  textarea {
    padding: 10px 12px;
    font-family: var(--font-sans);
    font-size: var(--text-body-sm);
    color: var(--text);
    background: var(--surface);
    border: var(--border-strong);
  }
  textarea {
    resize: vertical;
    font-family: var(--font-mono, monospace);
    line-height: 1.6;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .help {
    margin: 0;
    font-size: 12px;
    color: var(--text-3);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-block-start: var(--space-3);
  }
  .status {
    font-size: var(--text-body-sm);
    color: var(--text-2);
  }
</style>

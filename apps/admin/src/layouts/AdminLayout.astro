---
import "../styles/global.css";
import Logo from "@nb/ui/core/Logo.astro";

interface Props { title: string; session?: App.Locals["session"] }
const { title, session } = Astro.props;

const NAV = [
  { href: "/", label: "Overview" },
  { href: "/posts/", label: "Posts" },
  { href: "/components/", label: "Components" },
  { href: "/media/", label: "Media" },
  { href: "/tokens/", label: "Tokens" },
  { href: "/health/", label: "Health" },
];
const path = Astro.url.pathname;
const active = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- An admin panel has no business being indexed. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · nickbevers.dev admin</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem("nb-admin-theme") ||
          (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      } catch (e) { /* private mode: keep the default */ }
    </script>
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>

    {session && (
      <header class="bar">
        <div class="wrap inner">
          <a href="/" class="brand">
            <Logo height={22} />
            <span>admin</span>
          </a>
          <nav aria-label="Admin">
            <ul role="list">
              {NAV.map((n) => (
                <li>
                  <a href={n.href} aria-current={active(n.href) ? "page" : undefined}>{n.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <div class="who">
            <button type="button" data-theme-toggle class="ghost" aria-pressed="false"><span data-theme-label>Light</span></button>
            <span class="user">{session.login}</span>
            <form method="POST" action="/api/auth/logout">
              <button type="submit" class="ghost">Sign out</button>
            </form>
          </div>
        </div>
      </header>
    )}

    <main id="main" tabindex="-1"><slot /></main>

    <script is:inline>
      (function () {
        var b = document.querySelector("[data-theme-toggle]");
        if (!b) return;
        var label = b.querySelector("[data-theme-label]");
        function sync() {
          var dark = document.documentElement.dataset.theme === "dark";
          if (label) label.textContent = dark ? "Dark" : "Light";
          b.setAttribute("aria-pressed", String(dark));
          b.setAttribute("title", dark ? "Switch to the light theme" : "Switch to the dark theme");
        }
        sync();
        b.addEventListener("click", function () {
          var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem("nb-admin-theme", next); } catch (e) {}
          sync();
        });
      })();
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
  .skip {
    position: absolute; inset-inline-start: var(--space-4); inset-block-start: -100%;
    z-index: 100; padding: var(--space-3) var(--space-5);
    background: var(--accent); color: var(--accent-on);
    border: var(--border-strong); font-weight: var(--weight-bold); text-decoration: none;
  }
  .skip:focus { inset-block-start: var(--space-4); }

  .bar { border-bottom: var(--border-strong); background: var(--bg-alt); }
  .inner {
    display: flex; align-items: center; gap: var(--space-6);
    padding-block: var(--space-3); flex-wrap: wrap;
  }
  .brand {
    display: flex; align-items: center; gap: var(--space-3);
    color: var(--text); text-decoration: none;
    font-size: var(--text-meta); font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-meta); text-transform: uppercase;
  }
  nav ul { display: flex; gap: var(--space-1); list-style: none; margin: 0; padding: 0; }
  nav a {
    display: inline-flex; align-items: center; min-block-size: var(--tap-min);
    padding: 6px 10px;
    font-size: var(--text-caption); font-weight: var(--weight-semibold);
    color: var(--text-2); text-decoration: none;
  }
  nav a:hover { background: var(--accent-bg); color: var(--accent); }
  nav a[aria-current="page"] {
    background: var(--accent-bg); color: var(--accent); font-weight: var(--weight-bold);
  }

  .who { margin-inline-start: auto; display: flex; align-items: center; gap: var(--space-3); }
  .user {
    font-size: var(--text-meta); font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-meta); text-transform: uppercase; color: var(--text-3);
  }
  .who form { margin: 0; }
  .ghost {
    min-block-size: var(--tap-min); padding: 5px 10px;
    font-family: var(--font-sans); font-size: var(--text-meta);
    font-weight: var(--weight-bold); letter-spacing: var(--tracking-meta);
    text-transform: uppercase; color: var(--text-3);
    background: transparent; border: 1px solid var(--line); cursor: pointer;
  }
  .ghost:hover { color: var(--accent); border-color: var(--accent-2); }
</style>

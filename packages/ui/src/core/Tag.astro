---
/** Tag chip. `as` lets the writing filter render real <button>s. */
interface Props {
  tone?: "outline" | "active" | "solid";
  as?: "span" | "a" | "button";
  href?: string;
  pressed?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { tone = "outline", as = "span", href, pressed, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : as;
const attrs: Record<string, unknown> = href ? { href } : as === "button" ? { type: "button" } : {};
if (pressed !== undefined) attrs["aria-pressed"] = String(pressed);
---

<Tag class:list={["tag", `t-${tone}`, className]} {...attrs} {...rest}><slot /></Tag>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    /* 24px floor for pointer targets (2.5.8) even though the type is 11px */
    min-height: var(--tap-min);
    padding: 4px 10px;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .t-outline { color: var(--text-3); background: transparent; border: 1px solid var(--line-strong); }
  .t-active  { color: var(--accent-on); background: var(--accent); border: 1px solid var(--line-strong); }
  .t-solid   { color: var(--warm-on); background: var(--warm); border: 1px solid var(--line-strong); }

  a.tag:hover, button.tag:hover { background: var(--accent-bg); color: var(--accent); }
  .t-active:hover { background: var(--accent); color: var(--accent-on); }

  a.tag:focus-visible, button.tag:focus-visible {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  button.tag { cursor: pointer; font: inherit; font-size: var(--text-meta); }
  @media (prefers-reduced-motion: reduce) { .tag { transition: none; } }
</style>

---
/**
 * A label, a dotted leader, and a value. The table-of-contents device.
 * The leader is decorative, so it is a border on an empty flex filler
 * rather than a row of dot characters a screen reader would read out.
 */
interface Props { class?: string; }
const { class: className } = Astro.props;
---

<div class:list={["row", className]}>
  <span class="label"><slot name="label" /></span>
  <span class="leader" aria-hidden="true"></span>
  <span class="value"><slot name="value" /></span>
</div>

<style>
  .row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-sans);
  }
  .label { flex: none; }
  .leader {
    flex: 1 1 auto;
    min-inline-size: var(--space-5);
    border-bottom: var(--leader);
    opacity: .5;
    transform: translateY(-.25em);
  }
  .value {
    flex: none;
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
  }
</style>

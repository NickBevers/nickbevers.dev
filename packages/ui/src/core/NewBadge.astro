---
/**
 * Blinking NEW badge. One of the two sanctioned retro artefacts.
 *
 * Two a11y notes:
 *  - ink text on the sand fill (4.97). sand-050 on sand-600 was 3.22, a fail.
 *  - the badge is usually placed inside a heading, so the visually-hidden
 *    comma stops a screen reader running "TitleNEW" together.
 */
interface Props {
  label?: string;
  /** `inline` drops the 24px target floor for use beside larger text. */
  inline?: boolean;
  class?: string;
}
const { label = "New", inline, class: className } = Astro.props;
---

<span class:list={["badge", { inline }, className]}><span class="sr">, </span>{label}</span>

<style>
  .badge {
    /* inline-flex + align-items so the badge centres its own text and sits on
       the same baseline box as a Tag when the two are laid out side by side.
       inline-block left the text top-aligned and the box short of the 24px
       target floor every other chip meets. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tap-min);
    padding: 3px 8px;
    font-family: var(--font-sans);
    font-size: var(--text-micro);
    font-weight: var(--weight-black);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* the tracking adds a trailing gap on the last letter; pull it back so
       the glyphs look optically centred rather than shoved left */
    text-indent: 0.16em;
    color: var(--warm-on);
    background: var(--warm);
    border-radius: var(--radius);
    vertical-align: middle;
  }

  /* The blink animates the FILL, not the whole element.
     Fading the element to .35 opacity looked gentler than the original
     on/off, but it put the text at 1.52:1 for half of every cycle: text
     that is still legible-looking while failing 1.4.3. Contrast has no
     exemption for animated content. Swapping the background between two
     tones of the same sand ramp keeps the retro flicker while the ink
     text stays at full opacity throughout. Worst phase: 4.97 light,
     7.69 dark. Both verified by the contrast gate. */
  .badge::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--warm);
    animation: nbBlink 1.1s step-end infinite;
    z-index: -1;
  }
  .badge {
    position: relative;
    isolation: isolate;
    background: var(--warm-dim);
  }

  /* Inside a heading or window chrome the badge is a small marker beside
     larger text, so the 24px target floor would make it tower over its
     neighbour. Only free-standing badges get the full height. */
  :where(h1, h2, h3, h4) .badge,
  .badge.inline {
    min-block-size: 0;
    padding: 3px 7px;
    vertical-align: 0.2em;
  }
  .sr {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  @keyframes nbBlink { 0%, 49% { opacity: 1 } 50%, 100% { opacity: 0 } }

  @media (prefers-reduced-motion: reduce) {
    .badge::before { animation: none; opacity: 1; }
  }
</style>

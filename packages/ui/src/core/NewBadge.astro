---
// Blinking NEW badge
interface Props {
  label?: string;
  /** `inline` drops the 24px target floor for use beside larger text. */
  inline?: boolean;
  class?: string;
}
const { label = "New", inline, class: className } = Astro.props;
---

<span class:list={["badge", { inline }, className]}
  ><span class="sr">, </span>{label}</span
>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tap-min);
    padding: 3px 8px;
    font-family: var(--font-sans);
    font-size: var(--text-micro);
    font-weight: var(--weight-black);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-indent: 0.16em;
    color: var(--warm-on);
    background: var(--warm);
    border-radius: var(--radius);
    vertical-align: middle;
  }

  /* The blink animates the FILL, not the whole element */
  .badge::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--warm);
    animation: nbBlink 1.1s step-end infinite;
    z-index: -1;
  }
  .badge {
    position: relative;
    isolation: isolate;
    background: var(--warm-dim);
  }

  :where(h1, h2, h3, h4) .badge,
  .badge.inline {
    min-block-size: 0;
    padding: 3px 7px;
    vertical-align: 0.2em;
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  @keyframes nbBlink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge::before {
      animation: none;
      opacity: 1;
    }
  }
</style>

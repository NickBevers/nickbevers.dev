---
/**
 * A slide-mount frame for a personal photo. Where no photo exists the frame
 * stays empty with a caption rather than reaching for stock imagery. The
 * design ships no illustration and no placeholder art.
 */
interface Props {
  kicker: string;
  title: string;
  blurb: string;
  number?: string;
  photoPrompt?: string;
  href?: string;
}
const { kicker, title, blurb, number, photoPrompt = "Photo to come", href } = Astro.props;
const Tag = href ? "a" : "div";
const attrs = href ? { href } : {};
---

<Tag class="card" {...attrs}>
  <div class="frame">
    <div class="slot">
      <slot>
        <span class="prompt">{photoPrompt}</span>
      </slot>
    </div>
  </div>
  <div class="body">
    <div class="kick">
      {number && <><span class="no">{number}</span><span class="dot" aria-hidden="true"></span></>}
      <span>{kicker}</span>
    </div>
    <h3 class="ttl">{title}</h3>
    <p class="blurb">{blurb}</p>
  </div>
</Tag>

<style>
  .card {
    display: block; color: var(--text); text-decoration: none;
    font-family: var(--font-sans);
  }
  .frame {
    border: var(--border-strong);
    background: var(--surface);
    padding: 8px;                 /* the slide mount inset */
    box-shadow: 5px 5px 0 var(--soft-shadow);
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  /* lifts up-left and the shadow both grows AND warms */
  a.card:hover .frame,
  a.card:focus-visible .frame {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--warm-2);
  }
  a.card:focus-visible .frame {
    outline: var(--focus-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }
  .slot {
    block-size: 160px;
    display: grid; place-items: center;
    background: var(--bg-alt);
    border: 1px dashed var(--line-strong);
    overflow: hidden;
  }
  .slot :global(img) { inline-size: 100%; block-size: 100%; object-fit: cover; }
  .prompt {
    padding: var(--space-4);
    font-size: var(--text-meta); font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-meta); text-transform: uppercase;
    color: var(--text-3); text-align: center;
  }

  .body { padding: 14px 16px 16px; }
  .kick {
    display: flex; align-items: center; gap: 9px;
    font-size: 10px; font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-meta); text-transform: uppercase;
    color: var(--text-3);
  }
  .no { color: var(--warm-text); font-variant-numeric: tabular-nums; }
  .dot { inline-size: 4px; block-size: 4px; background: var(--warm); }
  .ttl {
    margin: var(--space-2) 0 0;
    font-size: 17px; font-weight: var(--weight-bold);
    letter-spacing: -0.015em; line-height: 1.25;
  }
  .blurb { margin: 7px 0 0; font-size: 14px; line-height: 1.5; color: var(--text-2); }

  @media (prefers-reduced-motion: reduce) {
    .frame { transition: none; }
    a.card:hover .frame { transform: none; box-shadow: 5px 5px 0 var(--soft-shadow); }
  }
</style>
